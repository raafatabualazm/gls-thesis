+# --- CUDA 12 / CuPy 13 port: CuPy 13 puts its bundled (older) cuda_fp16.h first on the nvcc
+# include path; it clashes with the toolkit's cuda_bf16.h and libcudacxx. Force-include the
+# toolkit's own cuda_fp16.h first so the bundled copy is skipped by its include guard.
+import os as _os
+_fp16 = [_os.path.join(d, 'cuda_fp16.h') for d in (_os.path.join(_os.environ.get('CONDA_PREFIX', ''), 'targets/x86_64-linux/include'), _os.path.join(cp.cuda.get_cuda_path() or '', 'include')) if _os.path.isfile(_os.path.join(d, 'cuda_fp16.h'))]
+_GL0AM_CUDA12_OPTS = ('-include', _fp16[0]) if _fp16 else ()
+# CuPy 13 converts non-CuPy index objects through __array__; let CUDA torch tensors used as
+# indices into CuPy arrays (as the CuPy 11 fork accepted) go via host memory instead of raising.
+import torch as _th
+_th_array_orig = _th.Tensor.__array__
+def _th_array_cuda12(self, *a, **kw):
+    return _th_array_orig(self.detach().cpu() if self.is_cuda else self, *a, **kw)
+_th.Tensor.__array__ = _th_array_cuda12
+def _RawKernel12(code, name, *args, **kw):
+    kw['options'] = tuple(kw.get('options', ())) + _GL0AM_CUDA12_OPTS
+    return cp.RawKernel(code, name, *args, **kw)
+
